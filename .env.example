# Required for pyannote diarization. Use a read token and accept model terms on HF.
HF_TOKEN=your_huggingface_read_token

# Mac default:
WHISPER_ENGINE=mlx
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
DIARIZATION_DEVICE=auto

# MLX safety defaults. condition_on_previous_text can improve continuity, but
# it is prone to long repetition loops on difficult/mixed-language audio.
MLX_CONDITION_ON_PREVIOUS_TEXT=0
MLX_HALLUCINATION_SILENCE_THRESHOLD=2.0
MLX_TEMPERATURES=0.0,0.2,0.4,0.6

# CUDA / RTX 5090 experiments:
# WHISPER_ENGINE=faster-whisper
# FASTER_WHISPER_DEVICE=cuda
# FASTER_WHISPER_COMPUTE_TYPE=float16
# FASTER_WHISPER_BEAM_SIZE=5
# FASTER_WHISPER_VAD=1

# Local upload guard for the web UI.
MAX_UPLOAD_MB=2048
